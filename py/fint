#!/usr/bin/env python3
import click
import pathlib
import toml
import getpass

import backends


DEFAULT_CONFIG_PATH = pathlib.Path('./config.toml')


CONFIG={}


def load_config(path: str):
    global CONFIG
    CONFIG = toml.load(path)


def db():
    return backends.get_backend(CONFIG['BACKEND']) \
        .Database(CONFIG)


@click.group()
@click.option('-l', '--login', required=True,
              help='User login')
@click.option('-p', '--password', required=True,
              help='User password')
@click.option('-F', '--config', type=click.Path(), default=DEFAULT_CONFIG_PATH,
              show_default=True, help='Path to config as source')
@click.pass_context
def main(ctx, login: str, password: str, config: str):
    ctx.ensure_object(dict)

    load_config(config)
    if not db().authenticate(login, password):
        print('User', login, 'not authenticated')
        raise click.Abort
    ctx.obj['user'] = login


def abort_on_unprivileged(ctx):
    if not db().authorize(ctx.obj['user']):
        print('User', ctx.obj['user'], 'have not enough privileges')
        raise click.Abort

