################################################################################
# Commands for users management
################################################################################
@main.group()
@click.pass_context
def user(ctx):
    abort_on_unprivileged(ctx)


USERS_ROLES = [
    'user',
    'admin',
]

@user.command('add')
@click.option('-r', '--role', type=click.Choice(USERS_ROLES),
              default=USERS_ROLES[0], show_default=True,
              help='What role new user will be given')
@click.argument('login')
def user_add(login: str, role: str):
    if not db().add_user(login, getpass.getpass(f'Password {login}: '), role):
        print('Failed to create user:', login)
        raise click.Abort
    print('User', login, 'created')


@user.command('delete')
@click.argument('login')
def user_delete(login: str):
    if not db().delete_user(login):
        print('Failed to delete user:', login)
        raise click.Abort
    print('User', login, 'deleted')


